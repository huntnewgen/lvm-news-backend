# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://lvm_user:senha_segura@localhost:5432/lvm_news

# Redis (cache de sessão / rate limit)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=outro_segredo_diferente_para_refresh_token
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# IA (OpenAI ou Azure Cognitive Services) — preencha com sua própria chave
AI_PROVIDER=openai
OPENAI_API_KEY=
AZURE_COGNITIVE_KEY=
AZURE_COGNITIVE_ENDPOINT=

# CORS
FRONTEND_ORIGIN=http://localhost:5173
